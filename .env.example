# ── PythonAnywhere uchun .env fayl ──
# Bu faylni nusxalab, qiymatlarini o'zgartiring

# Django SECRET_KEY — yangi key generatsiya qiling:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY="BU YERGA YANGI SECRET_KEY QOYING"

# Production da DEBUG=False bo'lishi SHART
DEBUG=False

# Sizning PythonAnywhere domeningiz:
# Bepul plan: username.pythonanywhere.com
# Pullik: sizning-domen.com
ALLOWED_HOSTS=username.pythonanywhere.com

# PythonAnywhere flag
ON_PYTHONANYWHERE=True

# Frontend URL (agar alohida frontend bo'lsa)
FRONTEND_URL=https://username.pythonanywhere.com
